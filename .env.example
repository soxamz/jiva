# ------------------------------------------------------------
# General & Database Settings
# ------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.neon.tech/neondb?sslmode=require"
SESSION_SECRET="replace-with-a-long-random-secret-for-signed-demo-sessions"
# Public app origin used in patient QR exports. Set this to a tunnel or LAN URL for phone testing.
JIVA_APP_URL="http://localhost:3000"
UPLOADTHING_TOKEN="your-uploadthing-v7-token"
LINGO_API_KEY="replace-with-your-lingo-dev-api-key"
GROQ_API_KEY="replace-with-your-groq-api-key"
GEMINI_API_KEY="replace-with-your-gemini-api-key"
MISTRAL_API_KEY="replace-with-your-mistral-api-key"

# ------------------------------------------------------------
# Document AI / OCR (local FastAPI)
# ------------------------------------------------------------
OCR_PROVIDER=mistral
MISTRAL_OCR_MODEL=mistral-ocr-latest
OCR_CONFIDENCE_THRESHOLD=0.70

# ------------------------------------------------------------
# OCR Correction
# ------------------------------------------------------------
OCR_CORRECTION_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------
# LLM Extraction
# ------------------------------------------------------------
EXTRACTION_PROVIDER=mistral
MISTRAL_EXTRACTION_MODEL=ministral-14b-latest

# ------------------------------------------------------------
# Document AI Constraints
# ------------------------------------------------------------
MANUAL_REVIEW_THRESHOLD=0.70
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png
LOG_LEVEL=INFO
DOCUMENT_AI_REQUIRE_CONSENT=false
